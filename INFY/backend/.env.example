ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=billsphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/billsphere

REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

TAX_PERCENTAGE=18
TAX_RATES_JSON={"IN": 18.0, "US": 0.0, "GB": 20.0, "AE": 5.0, "SG": 9.0}
SCHEDULER_TIMEZONE=UTC
ENABLE_APSCHEDULER=false
PAYMENT_RETRY_INTERVAL_HOURS=24
MOCK_PAYMENT_SUCCESS_RATE=0.80

LOG_LEVEL=INFO
LOG_FILE=logs/billsphere.log
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000

COMPANY_NAME=BillSphere
COMPANY_EMAIL=support@billsphere.com
COMPANY_PHONE=+1-000-000-0000
COMPANY_ADDRESS=Your Company Address
COMPANY_COUNTRY=IN
COMPANY_STATE=Telangana
COMPANY_WEBSITE=https://billsphere.com
